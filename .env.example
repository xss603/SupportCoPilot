# ========================================================
# GitLab Support Automation & Triage Platform Environment
# ========================================================

# Database & Vector Store
DATABASE_URL=postgresql+asyncpg://postgres:postgrespassword@localhost:5432/app_db

# Task Queue (Redis)
REDIS_URL=redis://localhost:6379/0

# GitLab Instance & Webhook Secret
GITLAB_URL=https://gitlab.com
GITLAB_PRIVATE_TOKEN=glpat-your-personal-access-token
GITLAB_WEBHOOK_SECRET=super-secret-webhook-token
GITLAB_BOT_USERNAME=platform-support-bot
GITLAB_DEFAULT_PROJECT_ID=12345678

# LLM Provider (Google Gemini via OpenAI-compat or OpenAI or local Ollama/vLLM)
LLM_API_KEY=AIzaSyYourGeminiApiKeyHere
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
LLM_MODEL=gemini-2.5-flash
LLM_TEMPERATURE=0.2
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536

# Triage & Automation Guardrails
AUTO_PILOT_CONFIDENCE_THRESHOLD=0.85
DUPLICATE_SIMILARITY_THRESHOLD=0.82
ENABLE_AUTO_EXECUTION=false # Set to true to allow direct auto-posting on high confidence

# Knowledge Base & Documentation Portal
DOCS_BASE_URL=https://docs.example.com
ACADEMY_BASE_URL=https://academy.example.com
